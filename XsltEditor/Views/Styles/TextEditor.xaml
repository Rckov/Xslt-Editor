<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:aef="clr-namespace:ICSharpCode.AvalonEdit.Folding;assembly=ICSharpCode.AvalonEdit"
                    xmlns:ct="clr-namespace:XsltEditor.Views.UserControls">

   <Style TargetType="{x:Type ct:TextEditor}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
      <Setter Property="ShowLineNumbers" Value="True" />
      <Setter Property="Margin" Value="5,5,0,5" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Options">
         <Setter.Value>
            <ae:TextEditorOptions ConvertTabsToSpaces="True" EnableEmailHyperlinks="False" EnableHyperlinks="False" />
         </Setter.Value>
      </Setter>
   </Style>

   <Style TargetType="{x:Type aef:FoldingMargin}">
      <Setter Property="FoldingMarkerBrush" Value="{DynamicResource FoldingMarkerBrush}" />
      <Setter Property="SelectedFoldingMarkerBrush" Value="{DynamicResource FoldingMarkerSelectedBrush}" />
      <Setter Property="FoldingMarkerBackgroundBrush" Value="{DynamicResource FoldingMarkerBackground}" />
      <Setter Property="SelectedFoldingMarkerBackgroundBrush" Value="{DynamicResource FoldingMarkerBackground}" />
   </Style>
</ResourceDictionary>