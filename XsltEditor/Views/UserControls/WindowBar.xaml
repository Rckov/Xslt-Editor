<UserControl x:Class="XsltEditor.Views.UserControls.WindowBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">

   <Grid Height="29" WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition />
      </Grid.ColumnDefinitions>

      <!-- Window Icon -->
      <Image Grid.Column="0"
             Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
             Margin="5,0"
             Height="16"
             Width="16"
             Stretch="Uniform" />

      <!-- Window Title -->
      <TextBlock Grid.Column="1"
                 VerticalAlignment="Center"
                 Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Visibility="{Binding ShowTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Margin="5,0"
                 Foreground="{DynamicResource TextForeground}" />

      <!-- Left Content -->
      <ContentPresenter Grid.Column="2"
                        Content="{Binding LeftContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />

      <!-- Window Controls -->
      <StackPanel Grid.Column="3"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right">
         <ContentPresenter Content="{Binding RightContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />

         <!-- Minimize Button -->
         <Button Content="&#xE949;"
                 Style="{StaticResource CaptionButton}"
                 Command="{Binding MinimizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                 ToolTip="Minimize" />

         <!-- Maximize Button -->
         <Button Content="&#xE739;"
                 Style="{StaticResource CaptionButton}"
                 Command="{Binding MaximizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                 ToolTip="Maximize" />

         <!-- Close Button -->
         <Button Content="&#xE106;"
                 Style="{StaticResource CaptionButton}"
                 Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                 ToolTip="Close" />
      </StackPanel>
   </Grid>
</UserControl>