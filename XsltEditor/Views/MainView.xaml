<ct:Window x:Class="XsltEditor.Views.MainView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

           xmlns:ct="clr-namespace:XsltEditor.Controls"
           xmlns:bh="clr-namespace:XsltEditor.Core.Behaviors"

           xmlns:ad="https://github.com/Dirkster99/AvalonDock"
           xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
           xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"

           Height="650"
           Width="1200"
           Title="Xslt Editor"

           ResizeMode="CanResizeWithGrip"
           WindowStartupLocation="CenterScreen"
           Style="{StaticResource WindowStyle}" AcrylicEffect="True">

   <ct:Window.Resources>
      <ContextMenu x:Key="CommonTextEditorContextMenu">
         <MenuItem Icon="&#xE7A7;" Command="ApplicationCommands.Undo" />
         <MenuItem Icon="&#xE7A6;" Command="ApplicationCommands.Redo" />
         <MenuItem Icon="&#xE8C8;" Command="ApplicationCommands.Copy" />
         <MenuItem Icon="&#xE8C6;" Command="ApplicationCommands.Cut" />
         <MenuItem Icon="&#xE77F;" Command="ApplicationCommands.Paste" />
         <MenuItem Icon="&#xE74D;" Command="ApplicationCommands.Delete" />
      </ContextMenu>
   </ct:Window.Resources>

   <Border Style="{StaticResource BorderWindow}">
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>

         <ct:WindowBar Grid.Row="0" Background="{DynamicResource WindowBackgroundColor}">
            <ct:WindowBar.LeftContent>
               <Menu VerticalAlignment="Center" Background="Transparent">
                  <MenuItem Header="File">
                     <MenuItem Header="Open XSL" Icon="&#xE70B;" Command="{Binding XslDocument.OpenCommand}" />
                     <MenuItem Header="Open XML" Icon="&#xE8C4;" Command="{Binding XmlDocument.OpenCommand}" />
                  </MenuItem>

                  <MenuItem Header="Edit">
                     <MenuItem Icon="&#xE7A7;" Command="ApplicationCommands.Undo" />
                     <MenuItem Icon="&#xE7A6;" Command="ApplicationCommands.Redo" />
                     <MenuItem Icon="&#xE8C8;" Command="ApplicationCommands.Copy" />
                     <MenuItem Icon="&#xE8C6;" Command="ApplicationCommands.Cut" />
                     <MenuItem Icon="&#xE77F;" Command="ApplicationCommands.Paste" />
                     <MenuItem Icon="&#xE74D;" Command="ApplicationCommands.Delete" />
                  </MenuItem>

                  <MenuItem Header="Tools">
                     <MenuItem Header="Completion Data" Icon="&#xE75D;" Command="{Binding OpenCompletionWindowCommand}" />
                  </MenuItem>

                  <Separator Style="{StaticResource VerticalSeparator}" Height="20" />

                  <MenuItem Icon="&#xE721;" Command="ApplicationCommands.Find" />
               </Menu>
            </ct:WindowBar.LeftContent>

            <ct:WindowBar.RightContent>
               <Button Content="&#xE706;" FontSize="12" Style="{StaticResource CaptionButton}" Command="{Binding SwitchThemeCommand}" />
            </ct:WindowBar.RightContent>
         </ct:WindowBar>

         <Border Grid.Row="1" Padding="5,5,5,0">
            <ad:DockingManager AnchorablePaneControlStyle="{StaticResource CustomLayoutAnchorablePane}">
               <ad:LayoutRoot>
                  <ad:LayoutPanel Orientation="Horizontal">
                     <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="2*">
                        <ad:LayoutAnchorablePane DockHeight="2*">
                           <ad:LayoutAnchorable Title="XSL" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
                              <Border>
                                 <ae:TextEditor x:Name="XslEditor" DataContext="{Binding XslDocument}">
                                    <i:Interaction.Behaviors>
                                       <bh:TextEditorHighlightingBehavior />
                                       <bh:TextEditorTextBehavior Text="{Binding Content, Mode=TwoWay}" />
                                       <bh:TextEditorCompleteBehavior />
                                       <bh:TextEditorFoldingBehavior />
                                    </i:Interaction.Behaviors>
                                    <ae:TextEditor.ContextMenu>
                                       <StaticResource ResourceKey="CommonTextEditorContextMenu" />
                                    </ae:TextEditor.ContextMenu>
                                 </ae:TextEditor>
                              </Border>
                           </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutAnchorablePane>
                           <ad:LayoutAnchorable Title="XML" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
                              <Border>
                                 <ae:TextEditor x:Name="XmlEditor" DataContext="{Binding XmlDocument}">
                                    <i:Interaction.Behaviors>
                                       <bh:TextEditorHighlightingBehavior />
                                       <bh:TextEditorTextBehavior Text="{Binding Content, Mode=TwoWay}" />
                                       <bh:TextEditorFoldingBehavior />
                                    </i:Interaction.Behaviors>
                                    <ae:TextEditor.ContextMenu>
                                       <StaticResource ResourceKey="CommonTextEditorContextMenu" />
                                    </ae:TextEditor.ContextMenu>
                                 </ae:TextEditor>
                              </Border>
                           </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                     </ad:LayoutAnchorablePaneGroup>

                     <ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorable Title="Result" CanHide="False" CanAutoHide="False" CanDockAsTabbedDocument="False">
                           <wv:WebView2 DefaultBackgroundColor="Transparent">
                              <i:Interaction.Behaviors>
                                 <bh:WebView2Behavior />
                              </i:Interaction.Behaviors>
                           </wv:WebView2>
                        </ad:LayoutAnchorable>
                     </ad:LayoutAnchorablePane>
                  </ad:LayoutPanel>
               </ad:LayoutRoot>
            </ad:DockingManager>
         </Border>

         <Grid Grid.Row="2" Background="{DynamicResource WindowBackgroundColor}">
            <Grid.ColumnDefinitions>
               <ColumnDefinition />
               <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="5">
               <TextBlock Text="&#xF745;" Margin="0,0,3,0" FontSize="9" FontFamily="{StaticResource FontIcon}" VerticalAlignment="Center" />
               <TextBlock>
                  <Run Text="{Binding ElementName=XslEditor, Path=TextArea.Caret.Position.Line, StringFormat=Line: {0}}" />
                  <Run Text="{Binding ElementName=XslEditor, Path=TextArea.Document.LineCount, StringFormat=/ {0}, Mode=OneWay}" />
               </TextBlock>
               <TextBlock Text="{Binding ElementName=XslEditor, Path=TextArea.Caret.Position.Column, StringFormat=Column: {0}}" Margin="5,0,0,0" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="5" HorizontalAlignment="Right">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="80" />
               </Grid.ColumnDefinitions>

               <TextBlock Grid.Column="0"
                          TextAlignment="Right"
                          Margin="0,0,5,0"
                          Text="{Binding XslDocument.HasChanged, Converter={StaticResource BooleanToChangesConverter}, StringFormat='Changes: {0}'}" />
               <Separator Grid.Column="1" Height="13" HorizontalAlignment="Center" Style="{StaticResource VerticalSeparator}" />
               <TextBlock Grid.Column="2"
                          Text="{Binding XslDocument.Encoding.HeaderName, StringFormat='Encoding {0}', FallbackValue='Encoding: def'}"
                          TextAlignment="Left" TextTrimming="CharacterEllipsis" />
            </Grid>
         </Grid>
      </Grid>
   </Border>
</ct:Window>