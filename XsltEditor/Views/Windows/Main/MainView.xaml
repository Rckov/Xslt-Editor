<ct:Window x:Class="XsltEditor.Views.Windows.Main.MainView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

           xmlns:vm="clr-namespace:XsltEditor.ViewModels"
           xmlns:ct="clr-namespace:XsltEditor.Views.UserControls"
           xmlns:ad="https://github.com/Dirkster99/AvalonDock"
           xmlns:aeditCmd="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"

           Height="650"
           Width="1200"
           Title="Xslt Editor"

           ResizeMode="CanResizeWithGrip"
           WindowStartupLocation="CenterScreen"
           Style="{StaticResource WindowStyle}" AcrylicEffect="False">

   <ct:Window.InputBindings>
      <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
      <KeyBinding Key="G" Modifiers="Control" Command="{Binding OpenGoToLineWindowCommand}" />
   </ct:Window.InputBindings>

   <Border Style="{StaticResource BorderWindow}">
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>

         <ct:WindowBar Grid.Row="0" Background="{DynamicResource GeneralPanelBackground}">

            <!-- Left Side -->
            <ct:WindowBar.LeftContent>
               <Menu Background="Transparent" VerticalAlignment="Center">
                  <MenuItem Header="File">
                     <MenuItem Header="Open file"
                               Icon="&#xE70B;"
                               Command="{Binding OpenFileCommand}" />
                     <MenuItem Header="Create template"
                               Icon="&#xE7B8;"
                               IsEnabled="False" />

                     <Separator Style="{StaticResource SeparatorStyle}" />

                     <MenuItem Header="Save"
                               Icon="&#xE74E;"
                               Command="{Binding SaveCommand}" />
                  </MenuItem>

                  <MenuItem Header="Edit">
                     <MenuItem Header="Undo"
                               Icon="&#xE7A7;"
                               Command="ApplicationCommands.Undo" />
                     <MenuItem Header="Redo"
                               Icon="&#xE7A6;"
                               Command="ApplicationCommands.Redo" />

                     <Separator Style="{StaticResource SeparatorStyle}" />

                     <MenuItem Header="Copy"
                               Icon="&#xE8C8;"
                               Command="ApplicationCommands.Copy" />
                     <MenuItem Header="Cut"
                               Icon="&#xE8C6;"
                               Command="ApplicationCommands.Cut" />
                     <MenuItem Header="Paste"
                               Icon="&#xE77F;"
                               Command="ApplicationCommands.Paste" />
                     <MenuItem Header="Delete"
                               Icon="&#xE74D;"
                               Command="ApplicationCommands.Delete" />
                  </MenuItem>

                  <MenuItem Header="Tools">
                     <MenuItem Header="Go To Line"
                               Icon="&#xE8A3;"
                               Command="{Binding OpenGoToLineWindowCommand}" />
                     <MenuItem Header="Text Case" Icon="&#xE8D2;">
                        <MenuItem Header="Convert Text To Upper Case"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertToUppercase}" />
                        <MenuItem Header="Convert Text To Lower Case"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertToLowercase}" />
                        <MenuItem Header="Convert Text To Title Case"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertToTitleCase}" />
                        <MenuItem Header="Invert Text Case"
                                  Icon="&#xE1CD;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.InvertCase}" />
                     </MenuItem>
                     <MenuItem Header="White Spaces" Icon="&#xE290;">
                        <MenuItem Header="Remove Leading White Spaces"
                                  Icon="&#xE1CD;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.RemoveLeadingWhitespace}" />
                        <MenuItem Header="Remove Trailing White Spaces"
                                  Icon="&#xE1CD;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.RemoveTrailingWhitespace}" />
                        <MenuItem Header="Convert Tabs To Spaces"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertTabsToSpaces}" />
                        <MenuItem Header="Convert Spaces To Tabs"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertSpacesToTabs}" />
                        <MenuItem Header="Convert Leading Tabs To Spaces"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertLeadingTabsToSpaces}" />
                        <MenuItem Header="Convert Leading Spaces To Tabs"
                                  Icon="&#xE943;"
                                  Command="{x:Static aeditCmd:AvalonEditCommands.ConvertLeadingSpacesToTabs}" />
                     </MenuItem>

                     <Separator Style="{StaticResource SeparatorStyle}" />

                     <MenuItem Header="Delete Line"
                               Icon="&#xE738;"
                               Command="{x:Static aeditCmd:AvalonEditCommands.DeleteLine}" />
                  </MenuItem>

                  <MenuItem Header="Services">
                     <MenuItem Header="Completion"
                               Icon="&#xE8A4;"
                               Command="{Binding OpenCompletionWindowCommand}" />

                     <MenuItem Header="Snippets"
                               Icon="&#xE81E;"
                               IsEnabled="False" />
                  </MenuItem>

                  <Separator Style="{StaticResource SeparatorStyle}" Height="20" />

                  <MenuItem Header="Compile"
                            Icon="&#xE768;"
                            Visibility="Collapsed" />
               </Menu>
            </ct:WindowBar.LeftContent>

            <!-- Right Side -->
            <ct:WindowBar.RightContent>
               <Button ToolTip="Settings"
                       Content="&#xE713;"
                       FontSize="12"
                       Style="{StaticResource CaptionButton}"
                       Command="{Binding OpenSettingsWindowCommand}" />
            </ct:WindowBar.RightContent>
         </ct:WindowBar>

         <Border Grid.Row="1" Padding="5">
            <ad:DockingManager DocumentsSource="{Binding Documents}" AnchorablesSource="{x:Null}"
                               ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                               IsVirtualizingAnchorable="True" IsVirtualizingDocument="True">
               <ad:DockingManager.Resources>
                  <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                     <ct:TextEditor Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly, Mode=TwoWay}"
                                    Line="{Binding Line, Mode=TwoWay}" Column="{Binding Column, Mode=TwoWay}"
                                    SyntaxHighlighting="{Binding Highlighting, Mode=OneWay}">
                        <ct:TextEditor.ContextMenu>
                           <ContextMenu>
                              <MenuItem Header="Cut"
                                        Icon="&#xE8C6;"
                                        Command="ApplicationCommands.Cut" />
                              <MenuItem Header="Copy"
                                        Icon="&#xE8C8;"
                                        Command="ApplicationCommands.Copy" />
                              <MenuItem Header="Paste"
                                        Icon="&#xE77F;"
                                        Command="ApplicationCommands.Paste" />

                              <Separator Style="{StaticResource SeparatorStyle}" />

                              <MenuItem Header="Select All"
                                        Icon="&#xE8B3;"
                                        Command="ApplicationCommands.SelectAll" />

                              <Separator Style="{StaticResource SeparatorStyle}" />

                              <MenuItem Header="Undo"
                                        Icon="&#xE7A7;"
                                        Command="ApplicationCommands.Undo" />
                              <MenuItem Header="Redo"
                                        Icon="&#xE7A6;"
                                        Command="ApplicationCommands.Redo" />

                              <Separator Style="{StaticResource SeparatorStyle}" />

                              <MenuItem Header="Expand All"
                                        Icon="&#xF164;"
                                        Command="{x:Static ct:TextEditorCommands.ExpandAllFolds}" />
                              <MenuItem Header="Collapse All"
                                        Icon="&#xF166;"
                                        Command="{x:Static ct:TextEditorCommands.CollapseAllFolds}" />
                           </ContextMenu>
                        </ct:TextEditor.ContextMenu>
                     </ct:TextEditor>
                  </DataTemplate>
               </ad:DockingManager.Resources>

               <ad:LayoutRoot>
                  <ad:LayoutPanel Orientation="Horizontal">
                     <ad:LayoutDocumentPane />

                     <ad:LayoutAnchorablePane DockWidth="300">
                        <ad:LayoutAnchorable Title="Result" CanHide="False" CanAutoHide="False" />
                     </ad:LayoutAnchorablePane>
                  </ad:LayoutPanel>
               </ad:LayoutRoot>
            </ad:DockingManager>
         </Border>

         <Grid Grid.Row="2" Background="{DynamicResource GeneralPanelBackground}">
            <Grid.ColumnDefinitions>
               <ColumnDefinition />
               <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Left Side -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5">
               <TextBlock Foreground="{DynamicResource TextInactiveForeground}" VerticalAlignment="Center">
                  <Run Text="&#xF745;" FontFamily="{StaticResource FontIcon}" FontSize="9" />

                  <Hyperlink Command="{Binding OpenFileInExplorerCommand}" Foreground="{DynamicResource TextInactiveForeground}" TextDecorations="None">
                     <Run Text="{Binding ActiveDocument.FilePath, TargetNullValue='No file selected'}" />
                  </Hyperlink>
               </TextBlock>
            </StackPanel>

            <!-- Right Side -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
               <TextBlock Text="has changes" VerticalAlignment="Center"
                          Foreground="Gray" Margin="5,0"
                          Visibility="{Binding ActiveDocument.IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />

               <Button Style="{StaticResource StatusBarButton}" VerticalAlignment="Center" Command="{Binding OpenGoToLineWindowCommand}">
                  <TextBlock Foreground="{DynamicResource TextInactiveForeground}">
                     <Run Text="{Binding ActiveDocument.Line, StringFormat='Ln: {0},'}" />
                     <Run Text="{Binding ActiveDocument.Column, StringFormat='Col: {0}'}" />
                  </TextBlock>
               </Button>

               <CheckBox IsChecked="{Binding ActiveDocument.IsReadOnly}" VerticalAlignment="Center">
                  <CheckBox.Template>
                     <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Bd" Padding="4,2">
                           <TextBlock x:Name="State" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextInactiveForeground}" />
                        </Border>

                        <ControlTemplate.Triggers>
                           <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="State" Property="TextBlock.Text" Value="Read Only" />
                           </Trigger>
                           <Trigger Property="IsChecked" Value="False">
                              <Setter TargetName="State" Property="TextBlock.Text" Value="Write Mode" />
                           </Trigger>
                           <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
                           </Trigger>
                        </ControlTemplate.Triggers>
                     </ControlTemplate>
                  </CheckBox.Template>
               </CheckBox>

               <TextBlock Foreground="{DynamicResource TextInactiveForeground}"
                          Text="{Binding ActiveDocument.Encoding.EncodingName, FallbackValue=UTF-8}"
                          VerticalAlignment="Center" Margin="5,0" />
            </StackPanel>
         </Grid>
      </Grid>
   </Border>
</ct:Window>