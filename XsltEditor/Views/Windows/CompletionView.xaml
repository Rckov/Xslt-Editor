<ct:Window x:Class="XsltEditor.Views.Windows.CompletionView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ct="clr-namespace:XsltEditor.Views.UserControls"
           Height="450"
           Width="500"
           Title="Completions"

           ResizeMode="CanResizeWithGrip"
           WindowStartupLocation="CenterScreen"
           Style="{StaticResource WindowStyle}" AcrylicEffect="False">

   <Border Style="{StaticResource BorderWindow}">
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
         </Grid.RowDefinitions>

         <ct:WindowBar Grid.Row="0"
                       Background="{DynamicResource GeneralPanelBackground}"
                       Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       ShowTitle="True" />

         <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource GeneralPanelBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
               <ListBox ItemsSource="{Binding CompletionData}"
                        SelectedItem="{Binding SelectedData}"
                        DisplayMemberPath="Text"
                        Margin="2"
                        Style="{StaticResource ListBoxStyle}" />
            </Border>

            <StackPanel Grid.Row="1" Margin="0,10">
               <TextBlock Text="New completion text:"
                          Margin="0,0,0,5"
                          Foreground="{DynamicResource TextForeground}" />
               <TextBox Text="{Binding NameData, UpdateSourceTrigger=PropertyChanged}"
                        Foreground="{DynamicResource TextForeground}"
                        Background="{DynamicResource GeneralPanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        Padding="5,3"
                        BorderThickness="1" />
            </StackPanel>

            <Grid Grid.Row="2">
               <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
               </Grid.ColumnDefinitions>

               <Button Grid.Column="0"
                       Content="Add"
                       Command="{Binding AddCommand}"
                       Style="{StaticResource CompletionButton}"
                       Margin="0,0,5,0" />
               <Button Grid.Column="1"
                       Content="Delete"
                       Command="{Binding DeleteCommand}"
                       Style="{StaticResource CompletionButton}"
                       Margin="5,0" />
               <Button Grid.Column="2"
                       Content="Save"
                       Command="{Binding SaveCommand}"
                       Style="{StaticResource CompletionButton}"
                       Margin="5,0,0,0" />
            </Grid>
         </Grid>
      </Grid>
   </Border>
</ct:Window>