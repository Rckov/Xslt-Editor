<Application x:Class="XsltEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:XsltEditor.Core.Converters">
   <Application.Resources>
      <ResourceDictionary>
         <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Styles/Generic.xaml" />
            <ResourceDictionary Source="Resources/Styles/AvalonDock.xaml" />
            <ResourceDictionary Source="Resources/Styles/TextEditor.xaml" />

            <ResourceDictionary Source="Resources/Themes/LightBrushes.xaml" />
         </ResourceDictionary.MergedDictionaries>

         <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
         <converters:BooleanToChangesConverter x:Key="BooleanToChangesConverter" />
      </ResourceDictionary>
   </Application.Resources>
</Application>