<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>XSLT Editor</AssemblyName>
    <ApplicationIcon>Resources\appicon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transform\XsltEditor.Transform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Themes\DarkHighlighting.xshd" />
    <Resource Include="Resources\Themes\DefaultHighlighting.xshd" />
    <Resource Include="Resources\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="XsltEditor.snippets.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
