<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
                    xmlns:aef="clr-namespace:ICSharpCode.AvalonEdit.Folding;assembly=ICSharpCode.AvalonEdit"
                    xmlns:ct="clr-namespace:XsltEditor.Views.UserControls">

    <Style TargetType="{x:Type ct:TextEditor}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="ShowLineNumbers" Value="True" />
        <Setter Property="Margin" Value="5,5,0,5" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Options">
            <Setter.Value>
                <ae:TextEditorOptions EnableEmailHyperlinks="False" EnableHyperlinks="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type aef:FoldingMargin}">
        <Setter Property="FoldingMarkerBrush" Value="{DynamicResource FoldingMarkerBrush}" />
        <Setter Property="SelectedFoldingMarkerBrush" Value="{DynamicResource FoldingMarkerSelectedBrush}" />
        <Setter Property="FoldingMarkerBackgroundBrush" Value="{DynamicResource FoldingMarkerBackground}" />
        <Setter Property="SelectedFoldingMarkerBackgroundBrush" Value="{DynamicResource FoldingMarkerBackground}" />
    </Style>

    <Style TargetType="ae:SearchPanel">
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ae:SearchPanel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Name="PART_searchTextBox"
                                     Width="220"
                                     Focusable="True"
                                     FontSize="12"
                                     VerticalContentAlignment="Center">
                                <TextBox.Text>
                                    <Binding Path="SearchPattern"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <ExceptionValidationRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <Button Command="ae:SearchCommands.FindPrevious"
                                    ToolTip="Find Previous"
                                    Style="{DynamicResource FlatButtonStyle}"
                                    Padding="6,4" Margin="2,0,0,0">
                                <TextBlock Text="&#xE70E;" FontFamily="{DynamicResource FontIcon}" FontSize="11" />
                            </Button>

                            <Button Command="ae:SearchCommands.FindNext"
                                    ToolTip="Find Next"
                                    Style="{DynamicResource FlatButtonStyle}"
                                    Padding="6,4">
                                <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FontIcon}" FontSize="11" />
                            </Button>

                            <ToggleButton IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                                          ToolTip="Match Case"
                                          Style="{DynamicResource FlatToggleButtonStyle}"
                                          Padding="6,4">
                                <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" />
                            </ToggleButton>

                            <ToggleButton IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                                          ToolTip="Whole Words"
                                          Style="{DynamicResource FlatToggleButtonStyle}"
                                          Padding="6,4">
                                <TextBlock Text="W" FontSize="11" FontWeight="SemiBold"
                                           TextDecorations="Underline" />
                            </ToggleButton>

                            <ToggleButton IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                                          ToolTip="Use Regex"
                                          Style="{DynamicResource FlatToggleButtonStyle}"
                                          Padding="6,4">
                                <TextBlock Text=".*" FontSize="11" FontFamily="Consolas" />
                            </ToggleButton>

                            <Button Command="ae:SearchCommands.CloseSearchPanel"
                                    ToolTip="Close"
                                    Style="{DynamicResource FlatButtonStyle}"
                                    Padding="6,4">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcon}" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="cc:CompletionWindow">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
    </Style>

    <Style TargetType="cc:CompletionListBox">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
</ResourceDictionary>