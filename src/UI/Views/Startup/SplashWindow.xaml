<Window x:Class="XsltEditor.Views.Startup.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="50,36"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE943;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="36"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Xslt Editor"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Center" />

            <ProgressBar IsIndeterminate="True"
                         Height="2"
                         Margin="0,18,0,0"
                         Width="180"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource BorderBrush}"
                         BorderThickness="0" />
        </StackPanel>
    </Border>
</Window>