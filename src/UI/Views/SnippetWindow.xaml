<Window x:Class="XsltEditor.Views.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ct="clr-namespace:XsltEditor.Views.UserControls"
        Title="Snippets"
        Width="350"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Padding" Value="15,4" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ct:WindowBar Grid.Row="0"
                      Title="Snippets"
                      ShowTitle="True"
                      CanMaximized="False"
                      CanMinimized="False"
                      Background="{DynamicResource RegionBrush}" />

        <ListBox Grid.Row="1" Margin="10,10,10,0"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 DisplayMemberPath="Text"
                 Background="{DynamicResource RegionBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1" />

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />

            <Button Grid.Column="1" Content="Add"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding AddCommand}" />
            <Button Grid.Column="2" Content="Remove"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding RemoveCommand}" />
            <Button Grid.Column="3" Content="Save"
                    Style="{StaticResource ActionButtonStyle}"
                    Command="{Binding SaveCommand}"
                    Click="OnCloseClick" Margin="0" />
        </Grid>
    </Grid>
</Window>