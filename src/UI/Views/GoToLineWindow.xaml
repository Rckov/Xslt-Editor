<Window x:Class="XsltEditor.Views.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ct="clr-namespace:XsltEditor.Views.UserControls"
        Title="Go to Line"
        Width="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ct:WindowBar Grid.Row="0"
                      Title="Go to Line"
                      ShowTitle="True"
                      CanMaximized="False"
                      CanMinimized="False"
                      Background="{DynamicResource RegionBrush}" />

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Margin="0,0,8,0"
                     Text="{Binding LineText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="OnPreviewTextInput" />

            <Button Grid.Column="1" Content="Go" Padding="20,4"
                    Background="{DynamicResource RegionBrush}"
                    Style="{StaticResource FlatButtonStyle}"
                    Command="{Binding GoCommand}"
                    Click="OnGoClick" />
        </Grid>
    </Grid>
</Window>