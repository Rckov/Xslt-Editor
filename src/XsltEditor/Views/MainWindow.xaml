<Window x:Class="XsltEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:views="clr-namespace:XsltEditor.Views.Views"

        Height="650"
        Width="1200"
        Title="Xslt Editor"

        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveDocumentCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding ActiveDocument.OpenCaretViewCommand}" />
    </Window.InputBindings>

    <Border Style="{StaticResource BorderWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:WindowBarContent Grid.Row="0" />
            <views:MainContent Grid.Row="1" />
            <views:BottomStatusContent Grid.Row="2" />
        </Grid>
    </Border>
</Window>