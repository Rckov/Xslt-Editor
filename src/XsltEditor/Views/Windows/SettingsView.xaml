<Window x:Class="XsltEditor.Views.Windows.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:ct="clr-namespace:XsltEditor.Views.UserControls"

        Height="350"
        Width="300"
        Title="Settings"

        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

   <Border Style="{StaticResource BorderWindow}">
      <Grid>
         <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
         </Grid.RowDefinitions>

         <ct:WindowBar Grid.Row="0" Background="{DynamicResource GeneralPanelBackground}" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowTitle="True" />

         <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
               <GroupBox Header="Appearance" Margin="0,0,0,10">
                  <Grid Margin="5">
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition />
                     </Grid.ColumnDefinitions>

                     <TextBlock Text="Theme:" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" />
                     <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                  </Grid>
               </GroupBox>

               <GroupBox Header="Xslt Transformation">
                  <StackPanel Margin="5">
                     <Grid>
                        <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="70" />
                           <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                           <RowDefinition />
                           <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Engine:" VerticalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource TextForeground}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Engines}" Margin="0,0,0,10" SelectedItem="{Binding SelectedEngine}" />

                        <TextBlock Text="Compile:" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource TextForeground}" />
                        <CheckBox Content="Runtime" Grid.Column="1" Grid.Row="1" IsChecked="{Binding IsRuntimeCompile}" Style="{StaticResource SettingsCheckBox}" />
                     </Grid>
                  </StackPanel>
               </GroupBox>
            </StackPanel>
         </ScrollViewer>
      </Grid>
   </Border>
</Window> 