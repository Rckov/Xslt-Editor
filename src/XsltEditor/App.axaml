<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XsltEditor.App"
			 xmlns:semi="https://irihi.tech/semi"
			 xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
			 xmlns:vm="using:XsltEditor.ViewModels.Documents"
			 xmlns:view="using:XsltEditor.Views.Documents">
	
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://XsltEditor/Resources/Icons/IconGeometries.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.DataTemplates>
		<DataTemplate DataType="vm:DocumentViewModel">
			<view:DocumentView />
		</DataTemplate>
	</Application.DataTemplates>

	<Application.Styles>
		<semi:DockSemiTheme />
		<semi:AvaloniaEditSemiTheme />
		<semi:SemiTheme Locale="ru-RU" />
		<u-semi:SemiTheme Locale="ru-RU"/>
	</Application.Styles>

</Application>