<Application x:Class="XsltEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:XsltEditor.Common.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Generic.xaml" />
                <ResourceDictionary Source="/Resources/Styles/AvalonDock.xaml" />
                <ResourceDictionary Source="/Resources/Styles/TextEditor.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <cv:ActiveDocumentConverter x:Key="ActiveDocumentConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>