<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
	<LangVersion>Preview</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	<PackageIcon>appicon.png</PackageIcon>
	<PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.1" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.3.0.2" />
    <PackageReference Include="Irihi.Ursa" Version="1.11.1" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="1.11.1" />
    <PackageReference Include="Semi.Avalonia" Version="11.2.1.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="11.2.0" />
    <PackageReference Include="Semi.Avalonia.Dock" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
	<AvaloniaResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Common\**" />
    <AvaloniaXaml Remove="ViewModels\Dock\**" />
    <Compile Remove="Common\**" />
    <Compile Remove="ViewModels\Dock\**" />
    <EmbeddedResource Remove="Common\**" />
    <EmbeddedResource Remove="ViewModels\Dock\**" />
    <None Remove="Common\**" />
    <None Remove="ViewModels\Dock\**" />
  </ItemGroup>
</Project>
